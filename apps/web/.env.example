# Copy this file to .env and fill in real values. Never commit .env.
# Vite only exposes variables prefixed with VITE_ to client-side code -
# never put secrets here, this file ships to the browser.
# Deploying? See docs/DEPLOYMENT.md for which of these go to Vercel and why.

VITE_API_BASE_URL=http://localhost:4000

# --- Part 3 (Authentication) ---
# From your Supabase project: Project Settings -> API. The anon key is safe
# to expose in client code by design - see docs/DATABASE.md for how it's
# protected (row-level security), never SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
