# Copy this file to .env and fill in real values. Never commit .env.
# Deploying? See docs/DEPLOYMENT.md for which of these go to Railway and why.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Part 2 (Database) ---
# PostgreSQL connection string. Works with a self-hosted Postgres instance or
# Supabase's managed Postgres connection string. Leave empty for Part 1 - the
# API boots without it and /api/health/ready reports database=not_configured.
DATABASE_URL=

# Encrypts IMEI/serial-number fields at rest (AES-256-GCM). Required before
# creating any Device with those fields. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Part 3 (Authentication) ---
# Supabase project used for managed authentication (see README - Auth architecture).
# SUPABASE_SERVICE_ROLE_KEY is backend-only: never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Part 20 (Security hardening) ---
# The same public/publishable anon key already in apps/web/.env's VITE_SUPABASE_ANON_KEY -
# safe to duplicate here (RLS enforces access, not this key). Only used by the HTTP-level
# authorization test suite to sign in as real, disposable test users; the running server
# never reads it. Optional - only needed to run tests/http/*.
SUPABASE_ANON_KEY=

# --- Part 7 (AI Recovery Agent) ---
# 'mock' requires no key and is the safe default for local development/demo.
# AI_PROVIDER=anthropic or openai requires AI_API_KEY. AI_MODEL optionally
# overrides the default model id (claude-sonnet-5 / gpt-4o-mini).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Part 8 (Device Location + Map) ---
# 'none' disables map tile/token issuance entirely (Recovery Map renders an
# explicit "unavailable" state instead of a fake map). 'maptiler' or 'mapbox'
# both require MAP_API_KEY (MapTiler: your API key: Mapbox: a public pk.
# token). 'google' is a declared but not-yet-implemented option - no frontend
# renderer is wired up for it yet.
MAP_PROVIDER=none
MAP_API_KEY=
